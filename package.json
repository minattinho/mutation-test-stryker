{
  "name": "mutation-test-stryker",
  "version": "1.0.0",
  "description": "Mutation testing com Stryker Mutator sobre a suíte de testes unitários Jest",
  "main": "index.js",
  "author": "Gabriel Minatto (minattinho)",
  "license": "MIT",
  "dependencies": {
    "jest": "^30.4.2",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "clean": "rimraf ./coverage && mkdirp ./coverage",
    "test": "npm run clean && jest",
    "coverage": "npm run clean && jest --coverage",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minattinho/mutation-test-stryker.git"
  }
}
